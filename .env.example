# =============================================================================
# PEISCL environment variables
# Copy to .env for local dev; add the same keys in Vercel:
# Project → Settings → Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Airtable — where form submissions are stored (REQUIRED)
# -----------------------------------------------------------------------------
# Create a personal access token at https://airtable.com/create/tokens
# Scopes needed: data.records:write  (add data.records:read only if you later
# build read endpoints). Grant it access to your PEISCL base.
AIRTABLE_TOKEN=paste-your-airtable-token-here

# From the base URL: https://airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=paste-your-base-id-here

# Optional — only set these if your tables aren't named as below.
# AIRTABLE_TABLE_REGISTRATIONS=Registrations
# AIRTABLE_TABLE_GUIDANCE=Guidance Requests
# AIRTABLE_TABLE_NEWSLETTER=Newsletter
# AIRTABLE_TABLE_PAYMENTS=Payments

# -----------------------------------------------------------------------------
# AI course assistant (OPTIONAL)
# The chat widget stays completely hidden unless one of these is set.
# Set EITHER of the following — Gemini takes priority if both are present.
# -----------------------------------------------------------------------------

# Option A (free): Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-google-ai-studio-key-here

# Optional — only if Google renames the model. Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Option B (paid, better answers, no data used for training):
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=paste-your-anthropic-key-here

# -----------------------------------------------------------------------------
# Paystack (OPTIONAL — checkout stays off until BOTH are true:
#   PAYSTACK_ENABLED=true  AND  the course has a price set in
#   COURSE_PRICES_NGN in src/data/courses.ts)
# -----------------------------------------------------------------------------
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=paste-your-paystack-secret-key-here

# Used to build the post-payment callback URL. Set to your live domain.
# PUBLIC_SITE_URL=https://peiscl.vercel.app
